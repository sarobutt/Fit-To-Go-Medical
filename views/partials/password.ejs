<div class="card">
  <h2>Change password</h2>
  <form method="post" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label for="cur">Current password</label><input id="cur" type="password" name="current_password" autocomplete="current-password" required></div>
    <div class="field"><label for="new">New password <span class="hint">(8+ characters)</span></label><input id="new" type="password" name="new_password" minlength="8" autocomplete="new-password" required></div>
    <button class="btn secondary">Update password</button>
  </form>
</div>
