<%- include('../partials/header') %>
<div class="card auth-card">
  <h1>Enter your code</h1>
  <p class="muted">Open your authenticator app and enter the 6-digit code for <strong><%= siteName %></strong>.</p>
  <form method="post" action="/staff/verify">
    <%- include('../partials/csrf') %>
    <div class="field"><label for="code">6-digit code</label>
      <input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7" autocomplete="one-time-code" class="code-input" required autofocus></div>
    <button class="btn block">Sign in</button>
  </form>
  <p class="small muted" style="margin-top:16px">Lost your phone? Ask another administrator to reset your two-step sign-in.</p>
</div>
<%- include('../partials/footer') %>
