<%- include('../partials/header') %>
<div class="card auth-card">
  <h1>Choose a new password</h1>
  <p class="muted">You signed in with a temporary password. Choose your own before continuing. Use at least <%= minLength %> characters; a short phrase of several words works well.</p>
  <form method="post" action="/staff/change-password">
    <%- include('../partials/csrf') %>
    <div class="field"><label for="new">New password</label><input id="new" type="password" name="new_password" minlength="<%= minLength %>" autocomplete="new-password" required autofocus></div>
    <div class="field"><label for="confirm">Confirm new password</label><input id="confirm" type="password" name="confirm_password" minlength="<%= minLength %>" autocomplete="new-password" required></div>
    <button class="btn block">Save and continue</button>
  </form>
</div>
<%- include('../partials/footer') %>
