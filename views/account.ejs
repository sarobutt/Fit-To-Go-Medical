<%- include('partials/header') %>
<div class="page-head"><h1>My account</h1></div>
<div class="grid grid-2">
  <div class="card">
    <h2><%= user.name %></h2>
    <dl class="details">
      <dt>Email</dt><dd><%= user.email %></dd>
      <% if (user.specialty) { %><dt>Specialty</dt><dd><%= user.specialty %></dd><% } %>
    </dl>
    <% if (typeof permissions !== 'undefined' && user.role === 'doctor') { %>
      <h3 style="margin-top:20px">What you can do</h3>
      <p class="small muted">Set by your administrator.</p>
      <ul class="small">
        <% for (const [key, label] of Object.entries(permissions)) { %>
          <li><%= user[key] ? '✔' : '✖' %> <%= label %></li>
        <% } %>
      </ul>
    <% } %>
  </div>
  <%- include('partials/password') %>
</div>
<%- include('partials/footer') %>
