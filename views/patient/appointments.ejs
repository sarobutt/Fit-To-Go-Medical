<%- include('../partials/header') %>
<div class="page-head"><h1>My appointments</h1><a class="btn" href="/patient/book">Book a test</a></div>
<div class="card flush">
  <% if (!appointments.length) { %>
    <div class="empty">You haven't booked any tests yet.</div>
  <% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Reference</th><th>Test</th><th>Clinic</th><th>When</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% for (const a of appointments) { %>
        <tr>
          <td class="nowrap"><%= a.reference %></td>
          <td><%= a.test_name %></td>
          <td><%= a.clinic_name %></td>
          <td class="nowrap"><%= time.formatDateTime(a.starts_at) %></td>
          <td><%- include('../partials/status', { status: a.status }) %></td>
          <td class="right"><a href="/patient/appointments/<%= a.id %>">View</a></td>
        </tr>
      <% } %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/footer') %>
