<%- include('../partials/header') %>
<% const q = (o, anchor) => '/patient/book?' + new URLSearchParams(Object.fromEntries(Object.entries({ test: testId, clinic: clinic && clinic.id, date, ...o }).filter(([, v]) => v))).toString() + (anchor ? '#' + anchor : '');
   const changing = typeof change !== 'undefined' ? change : null;
   const showTests = !test || changing === 'test';
   const showClinics = test && (!clinic || changing === 'clinic');
   const stepState = (n) => {
     const done = [Boolean(test), Boolean(test && clinic), false];
     if (done[n - 1]) return 'done';
     return (n === 1 && !test) || (n === 2 && test && !clinic) || (n === 3 && test && clinic) ? 'current' : '';
   };
   const groups = [['Morning', (h) => h < 12], ['Afternoon', (h) => h >= 12 && h < 17], ['Evening', (h) => h >= 17]]
     .map(([label, fits]) => [label, slots.filter((s) => fits(Number(s.starts_at.slice(11, 13))))]).filter(([, list]) => list.length); %>
<div class="page-head"><div><h1>Book a test</h1><p class="muted">Three quick steps, then pay securely with Stripe.</p></div></div>

<ol class="progress" aria-label="Booking progress">
  <li class="<%= stepState(1) %>">Test</li>
  <li class="<%= stepState(2) %>">Clinic</li>
  <li class="<%= stepState(3) %>">Date &amp; time</li>
  <li>Payment</li>
</ol>

<div class="stack">
  <section class="card step-anchor" id="step-1">
    <% if (showTests) { %>
      <h2 class="step-title"><span class="step-num">1</span> Choose your test</h2>
      <div class="choice-grid">
        <% for (const t of tests) { %>
          <a class="choice <%= t.id === testId ? 'selected' : '' %>" href="<%= q({ test: t.id, change: '' }, clinic ? 'step-3' : 'step-2') %>" <%- t.id === testId ? 'aria-current="true"' : '' %>>
            <strong><%= t.name %></strong>
            <span class="small muted"><%= t.duration_minutes %> min<%= t.turnaround ? ' · results ' + t.turnaround : '' %></span>
            <div class="price" style="font-size:1.05rem;margin-top:6px"><%= money(t.price_pence) %></div>
          </a>
        <% } %>
      </div>
    <% } else { %>
      <div class="chosen">
        <div class="what"><span class="tick" aria-hidden="true">✓</span><div><div class="small muted">Test</div><strong><%= test.name %></strong> · <%= money(test.price_pence) %></div></div>
        <a class="btn small secondary" href="<%= q({ change: 'test' }, 'step-1') %>">Change</a>
      </div>
      <% if (test.preparation) { %><div class="prep"><strong>Preparation:</strong> <%= test.preparation %></div><% } %>
    <% } %>
  </section>

  <section class="card step-anchor" id="step-2">
    <% if (!test) { %>
      <h2 class="step-title muted"><span class="step-num" style="background:var(--border);color:var(--muted)">2</span> Choose a clinic</h2>
    <% } else if (showClinics) { %>
      <h2 class="step-title"><span class="step-num">2</span> Choose a clinic</h2>
      <div class="choice-grid">
        <% for (const c of clinics) { %>
          <a class="choice <%= clinic && c.id === clinic.id ? 'selected' : '' %>" href="<%= q({ clinic: c.id, date: '', change: '' }, 'step-3') %>">
            <strong><%= c.name %></strong>
            <span class="small muted"><%= c.address %>, <%= c.city %></span>
          </a>
        <% } %>
      </div>
    <% } else { %>
      <div class="chosen">
        <div class="what"><span class="tick" aria-hidden="true">✓</span><div><div class="small muted">Clinic</div><strong><%= clinic.name %></strong><div class="small muted"><%= clinic.address %>, <%= clinic.city %></div></div></div>
        <a class="btn small secondary" href="<%= q({ change: 'clinic' }, 'step-2') %>">Change</a>
      </div>
    <% } %>
  </section>

  <section class="card step-anchor" id="step-3">
    <h2 class="step-title <%= test && clinic ? '' : 'muted' %>"><span class="step-num" <%- test && clinic ? '' : 'style="background:var(--border);color:var(--muted)"' %>>3</span> Pick a date and time</h2>
    <% if (!test || !clinic) { %>
      <p class="muted" style="margin:0">Choose a test and a clinic first.</p>
    <% } else if (!dates.length) { %>
      <p class="muted">No appointments are currently available at <%= clinic.name %>. Please try another clinic or check back soon.</p>
    <% } else { %>
      <div class="chips" style="margin-bottom:16px" aria-label="Available dates">
        <% for (const d of dates.slice(0, 21)) { %>
          <a class="chip <%= d.date === date ? 'selected' : '' %>" href="<%= q({ date: d.date }, 'step-3') %>">
            <%= time.formatDate(d.date).split(' ').slice(0, 3).join(' ') %><small><%= d.free %> free</small>
          </a>
        <% } %>
      </div>
      <% if (!slots.length) { %>
        <p class="muted">No times left on this day. Please pick another date.</p>
      <% } else { %>
        <form method="post" action="/patient/book" id="book-form">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="test_id" value="<%= testId || '' %>">
          <% for (const [label, list] of groups) { %>
            <div class="slot-group">
              <h3><%= label %></h3>
              <div class="slot-grid" role="radiogroup" aria-label="<%= label %> times">
                <% for (const s of list) { %>
                  <label class="slot">
                    <input type="radio" name="slot_id" value="<%= s.id %>" required>
                    <span class="t"><%= s.starts_at.slice(11, 16) %></span>
                    <span class="d"><%= s.doctor_name %></span>
                  </label>
                <% } %>
              </div>
            </div>
          <% } %>
          <div class="summary-bar" style="margin:20px -20px -20px">
            <div>
              <strong><%= test.name %></strong> at <%= clinic.name %>, <%= time.formatDate(date) %>
              <div class="small muted">Your slot is held for 30 minutes while you pay.</div>
            </div>
            <button class="btn accent">Continue to payment · <%= money(test.price_pence) %></button>
          </div>
        </form>
      <% } %>
    <% } %>
  </section>
</div>
<%- include('../partials/footer') %>
