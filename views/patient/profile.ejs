<%- include('../partials/header') %>
<div class="page-head"><h1>My details</h1></div>
<div class="grid grid-2">
  <div class="card">
    <h2>Personal details</h2>
    <form method="post" action="/patient/profile">
      <%- include('../partials/csrf') %>
      <div class="field"><label for="name">Full name</label><input id="name" name="name" type="text" value="<%= user.name %>" required></div>
      <div class="field"><label>Email</label><input type="email" value="<%= user.email %>" disabled><span class="hint">Contact the clinic to change your email.</span></div>
      <div class="form-row">
        <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" value="<%= user.phone || '' %>"></div>
        <div class="field"><label for="dob">Date of birth</label><input id="dob" name="date_of_birth" type="date" value="<%= user.date_of_birth || '' %>"></div>
      </div>
      <button class="btn">Save</button>
    </form>
  </div>
  <%- include('../partials/password') %>
  <div class="card">
    <h2>Your data</h2>
    <p class="muted">You can download everything we hold about you, or ask us to delete your account.</p>
    <p><a class="btn secondary" href="/patient/my-data.json">Download my data</a></p>
    <h3 style="margin-top:18px">Delete my account</h3>
    <% if (openRequest) { %>
      <p class="small">You asked us to delete your account on <%= time.formatDateTime(openRequest.created_at) %>. The clinic will reply within one month.</p>
    <% } else { %>
      <p class="small muted">By law, medical records have to be kept for a minimum period, so the clinic will tell you what can be deleted and what must be kept.</p>
      <form method="post" action="/patient/delete-request" data-confirm="Send a request to delete your account?">
        <%- include('../partials/csrf') %>
        <div class="field"><label for="details">Anything we should know? <span class="hint">(optional)</span></label><textarea id="details" name="details"></textarea></div>
        <button class="btn danger">Request account deletion</button>
      </form>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
