<%- include('../partials/header') %>
<div class="page-head">
  <div><h1>Hello, <%= user.name.split(' ')[0] %></h1><p class="muted">Manage your bookings and see your results.</p></div>
  <a class="btn" href="/patient/book">Book a test</a>
</div>
<div class="grid grid-2">
  <div class="card flush">
    <h2>Upcoming appointments</h2>
    <% if (!upcoming.length) { %>
      <div class="empty">No upcoming appointments. <a href="/patient/book">Book a test</a></div>
    <% } else { %>
      <div class="table-wrap"><table>
        <tbody>
        <% for (const a of upcoming) { %>
          <tr>
            <td><strong><%= a.test_name %></strong><div class="small muted"><%= a.clinic_name %></div></td>
            <td class="nowrap"><%= time.formatDateTime(a.starts_at) %></td>
            <td><%- include('../partials/status', { status: a.status }) %></td>
            <td class="right"><a href="/patient/appointments/<%= a.id %>">View</a></td>
          </tr>
        <% } %>
        </tbody>
      </table></div>
    <% } %>
  </div>
  <div class="card flush">
    <h2>Recent results</h2>
    <% if (!recent.length) { %>
      <div class="empty">Results from completed appointments will appear here.</div>
    <% } else { %>
      <div class="table-wrap"><table><tbody>
        <% for (const a of recent) { %>
          <tr>
            <td><strong><%= a.test_name %></strong><div class="small muted"><%= time.formatDate(a.starts_at) %></div></td>
            <td class="small"><%= a.result_summary ? a.result_summary.slice(0, 80) : 'No summary recorded' %></td>
            <td class="right"><a href="/patient/appointments/<%= a.id %>">Open</a></td>
          </tr>
        <% } %>
      </tbody></table></div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
