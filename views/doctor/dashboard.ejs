<%- include('../partials/header') %>
<% const today = time.todayLocal(); const rel = date === today ? 'Today' : (date === time.addDays(today, 1) ? 'Tomorrow' : (date === time.addDays(today, -1) ? 'Yesterday' : null)); %>
<div class="page-head">
  <div>
    <h1><%= rel ? rel + "'s patients" : 'Patients on ' + time.formatDate(date) %></h1>
    <p class="muted"><%= rel ? time.formatDate(date) : '' %><%= isToday ? ' · check patients in as they arrive' : '' %></p>
  </div>
  <div class="day-nav">
    <a class="btn small secondary" href="/doctor?date=<%= time.addDays(date, -1) %>">‹ Previous day</a>
    <% if (!isToday) { %><a class="btn small" href="/doctor">Today</a><% } %>
    <a class="btn small secondary" href="/doctor?date=<%= time.addDays(date, 1) %>">Next day ›</a>
    <form method="get" class="date-jump"><label class="sr-only" for="date">Go to date</label><input id="date" type="date" name="date" value="<%= date %>" data-autosubmit-date></form>
  </div>
</div>
<% if (!user.registration_number) { %>
  <div class="flash error" role="alert">Your GMC number isn't on file yet, so you can't complete appointments or issue certificates. Please ask an administrator to add it.</div>
<% } %>
<div class="grid grid-4" style="margin-bottom:16px">
  <div class="card stat"><span class="label">Waiting to arrive</span><span class="value"><%= counts.waiting %></span></div>
  <div class="card stat"><span class="label">Checked in</span><span class="value"><%= counts.checked_in %></span></div>
  <div class="card stat"><span class="label">Completed</span><span class="value"><%= counts.completed %></span></div>
  <div class="card stat"><span class="label">Free slots</span><span class="value"><%= freeSlots %></span></div>
</div>
<div class="card flush">
  <% if (!appointments.length) { %>
    <div class="empty">No patients booked for this day. <a href="/doctor/availability">Manage availability</a></div>
  <% } else { %>
  <div class="table-wrap"><table class="stack">
    <thead><tr><th>Time</th><th>Patient</th><th>Test</th><th>Clinic</th><th>Status</th><th class="right">Actions</th></tr></thead>
    <tbody>
    <% for (const a of appointments) { %>
      <tr>
        <td class="nowrap cell-main"><strong><%= a.starts_at.slice(11, 16) %></strong> <span class="patient-inline"><a href="/doctor/appointments/<%= a.id %>"><%= a.patient_name %></a></span></td>
        <td class="hide-phone"><a href="/doctor/appointments/<%= a.id %>"><%= a.patient_name %></a><div class="small muted"><%= a.reference %></div></td>
        <td data-label="Test"><%= a.test_name %></td>
        <td data-label="Clinic"><%= a.clinic_name %></td>
        <td><%- include('../partials/status', { status: a.status }) %></td>
        <td class="right cell-actions"><div class="row" style="justify-content:flex-end">
          <% if (a.status === 'confirmed' && isToday && user.can_check_in) { %>
            <form method="post" action="/doctor/appointments/<%= a.id %>/check-in" class="inline-form"><%- include('../partials/csrf') %><button class="btn small">Check in</button></form>
            <form method="post" action="/doctor/appointments/<%= a.id %>/no-show" class="inline-form" data-confirm="Mark <%= a.patient_name %> as a no-show?"><%- include('../partials/csrf') %><button class="btn small secondary">No-show</button></form>
          <% } else if (a.status === 'checked_in') { %>
            <a class="btn small" href="/doctor/appointments/<%= a.id %>#consultation">Open consultation</a>
          <% } else { %>
            <a class="btn small secondary" href="/doctor/appointments/<%= a.id %>">Open</a>
          <% } %>
        </div></td>
      </tr>
    <% } %>
    </tbody>
  </table></div>
  <% } %>
</div>
<% if (!user.can_check_in) { %><p class="small muted" style="margin-top:12px">Check-in is switched off for your account. Ask an administrator if you need it.</p><% } %>
<%- include('../partials/footer') %>
