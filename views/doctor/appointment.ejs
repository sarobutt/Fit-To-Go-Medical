<%- include('../partials/header') %>
<div class="page-head">
  <div><p class="muted small"><a href="/doctor?date=<%= appt.starts_at.slice(0, 10) %>">← Clinic day</a></p><h1><%= appt.patient_name %></h1><p class="muted"><%= appt.test_name %> · <%= appt.reference %></p></div>
  <%- include('../partials/status', { status: appt.status }) %>
</div>
<div class="grid grid-2">
  <div class="stack">
    <div class="card">
      <h2>Patient</h2>
      <dl class="details">
        <dt>Name</dt><dd><%= appt.patient_name %></dd>
        <dt>Date of birth</dt><dd><%= appt.date_of_birth ? time.formatDate(appt.date_of_birth) : '—' %></dd>
        <dt>Email</dt><dd><%= appt.patient_email %></dd>
        <dt>Phone</dt><dd><%= appt.patient_phone || '—' %></dd>
      </dl>
    </div>
    <div class="card">
      <h2>Appointment</h2>
      <dl class="details">
        <dt>When</dt><dd><%= time.formatDateTime(appt.starts_at) %></dd>
        <dt>Clinic</dt><dd><%= appt.clinic_name %></dd>
        <dt>Test</dt><dd><%= appt.test_name %></dd>
        <% if (appt.checked_in_at) { %><dt>Checked in</dt><dd><%= time.formatDateTime(appt.checked_in_at) %></dd><% } %>
        <% if (appt.cancel_reason) { %><dt>Cancelled</dt><dd><%= appt.cancel_reason %></dd><% } %>
      </dl>
      <div class="row" style="margin-top:16px">
        <% if (appt.status === 'confirmed' && user.can_check_in) { %>
          <form method="post" action="/doctor/appointments/<%= appt.id %>/check-in" class="inline-form"><%- include('../partials/csrf') %><button class="btn">Check in patient</button></form>
          <form method="post" action="/doctor/appointments/<%= appt.id %>/no-show" class="inline-form" data-confirm="Mark as no-show?"><%- include('../partials/csrf') %><button class="btn secondary">No-show</button></form>
        <% } %>
      </div>
      <% if (['confirmed', 'pending_payment'].includes(appt.status) && user.can_cancel_appointments) { %>
        <form method="post" action="/doctor/appointments/<%= appt.id %>/cancel" style="margin-top:16px" data-confirm="Cancel and refund this appointment?">
          <%- include('../partials/csrf') %>
          <div class="field"><label for="reason">Cancellation reason</label><input id="reason" type="text" name="reason" placeholder="Told to patient"></div>
          <button class="btn danger">Cancel & refund</button>
        </form>
      <% } %>
    </div>
  </div>
  <div class="stack">
    <div class="card flush">
      <h2>Previous visits</h2>
      <% if (history === null) { %>
        <div class="empty">You don't have permission to view patient history.</div>
      <% } else if (!history.length) { %>
        <div class="empty">No previous completed visits.</div>
      <% } else { %>
        <div class="table-wrap"><table><tbody>
          <% for (const h of history) { %>
            <tr><td class="nowrap"><%= time.formatDate(h.starts_at) %></td><td><strong><%= h.test_name %></strong><div class="small"><%= h.result_summary || '' %></div><% if (h.doctor_notes) { %><div class="small muted"><%= h.doctor_notes %></div><% } %></td></tr>
          <% } %>
        </tbody></table></div>
      <% } %>
    </div>
  </div>
</div>
<div class="card" style="margin-top:16px" id="consultation">
  <div class="card-head"><h2>Consultation record</h2><% if (record && record.amended_at) { %><span class="small muted">Amended <%= time.formatDateTime(record.amended_at) %></span><% } %></div>
  <% if (appt.status === 'completed' && record && record.finalised_at) { %>
    <% if (record.outcome) { %><div class="outcome-banner">Outcome: <%= OUTCOMES[record.outcome] %></div><% } %>
    <%- include('../partials/consultation-summary', { docsBase: '/doctor' }) %>
    <% if (appt.result_summary) { %><h3 class="summary-title">Summary for the patient</h3><p><%= appt.result_summary %></p><% } %>
    <% if (appt.doctor_notes) { %><h3 class="summary-title">Private clinical notes</h3><p><%= appt.doctor_notes %></p><% } %>
    <div class="row" style="margin-top:14px">
      <form method="post" action="/doctor/appointments/<%= appt.id %>/email-results" class="inline-form" data-confirm="Email the report and certificate to <%= appt.patient_email %>?"><%- include('../partials/csrf') %><button class="btn secondary">Email documents to patient</button></form>
      <% if (record.email_status) { %><span class="small muted">Email: <%= record.email_status %><%= record.emailed_at ? ' (' + time.formatDateTime(record.emailed_at) + ')' : '' %></span><% } %>
    </div>
    <% if (user.can_record_results) { %>
      <details style="margin-top:18px"><summary><strong>Correct this record</strong></summary>
        <div style="margin-top:14px"><%- include('../partials/consultation-form', { base: '/doctor' }) %></div>
      </details>
    <% } %>
  <% } else if (appt.status === 'checked_in') { %>
    <% if (user.can_record_results) { %>
      <p class="muted">Fill in what applies to this test and leave the rest blank. Use <strong>Save progress</strong> as you go; <strong>Complete</strong> creates the report and certificate and sends them to the patient.</p>
      <%- include('../partials/consultation-form', { base: '/doctor' }) %>
    <% } else { %>
      <p class="muted">You don't have permission to record results.</p>
    <% } %>
  <% } else if (appt.status === 'completed') { %>
    <h3 class="summary-title">Summary for the patient</h3><p><%= appt.result_summary || '—' %></p>
    <h3 class="summary-title">Private clinical notes</h3><p><%= appt.doctor_notes || '—' %></p>
  <% } else { %>
    <p class="muted">Check the patient in to start the consultation record.</p>
  <% } %>
</div>
<%- include('../partials/footer') %>
