<%- include('../partials/header') %>
<div class="page-head"><div><h1>My availability</h1><p class="muted">Publish sessions at your clinics. Each session is split into bookable slots.</p></div></div>
<div class="grid grid-2" style="align-items:start">
  <div class="card">
    <h2>Add a session</h2>
    <% if (!user.can_manage_availability) { %>
      <p class="muted">An administrator has switched off availability management for your account.</p>
    <% } else if (!clinics.length) { %>
      <p class="muted">You're not assigned to any clinic yet. Ask an administrator to assign you.</p>
    <% } else { %>
      <%- include('../partials/availability-form', { action: '/doctor/availability', doctors: null, clinics }) %>
    <% } %>
  </div>
  <div class="card flush">
    <h2>Upcoming sessions</h2>
    <% if (!sessions.length) { %><div class="empty">No upcoming sessions.</div><% } else { %>
    <div class="table-wrap"><table>
      <thead><tr><th>Date</th><th>Time</th><th>Clinic</th><th class="num">Booked</th><th></th></tr></thead>
      <tbody>
      <% for (const s of sessions) { %>
        <tr>
          <td class="nowrap"><%= time.formatDate(s.date) %></td>
          <td class="nowrap"><%= s.start_time %>–<%= s.end_time %><div class="small muted"><%= s.slot_minutes %>-min slots</div></td>
          <td><%= s.clinic_name %></td>
          <td class="num"><%= s.booked %> / <%= s.open_slots %></td>
          <td class="right"><a href="/doctor/availability/<%= s.id %>">Slots</a></td>
        </tr>
      <% } %>
      </tbody>
    </table></div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
