<%- include('../partials/header') %>
<div class="page-head"><div><h1>My schedule</h1><p class="muted">The sessions the clinic has set up for you. To change your hours, please contact the clinic administrator.</p></div></div>
<div class="card flush">
  <% if (!sessions.length) { %><div class="empty">No upcoming sessions yet.</div><% } else { %>
  <div class="table-wrap"><table class="stack">
    <thead><tr><th>Date</th><th>Time</th><th>Clinic</th><th class="num">Booked</th><th></th></tr></thead>
    <tbody>
    <% for (const s of sessions) { %>
      <tr>
        <td class="cell-main nowrap"><%= time.formatDate(s.date) %></td>
        <td class="nowrap" data-label="Time"><%= s.start_time %>–<%= s.end_time %><div class="small muted"><%= s.slot_minutes %>-min slots</div></td>
        <td data-label="Clinic"><%= s.clinic_name %></td>
        <td class="num" data-label="Booked"><%= s.booked %> / <%= s.open_slots %></td>
        <td class="right cell-actions"><a href="/doctor/availability/<%= s.id %>">See patients</a></td>
      </tr>
    <% } %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/footer') %>
