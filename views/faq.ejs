<%- include('partials/header') %>
<div class="page-head"><div><h1>Frequently asked questions</h1><p class="muted">Can't find what you need? See <a href="/tests">our tests and prices</a> or <a href="/clinics">contact your nearest clinic</a>.</p></div></div>
<section class="card faq" style="max-width:820px">
  <% if (!faqs.length) { %><p class="muted" style="margin:0">Questions and answers are coming soon.</p><% } %>
  <% for (const f of faqs) { %>
    <details><summary><%= f.question %></summary><div class="prose"><%- f.html %></div></details>
  <% } %>
</section>
<%- include('partials/footer') %>
