<% if (!appointments.length) { %><div class="empty">No appointments.</div><% } else { %>
<div class="table-wrap"><table class="stack">
  <thead><tr><th>When</th><th>Patient</th><th>Test</th><th>Clinic · Doctor</th><th>Status</th><th class="num">Price</th><th></th></tr></thead>
  <tbody>
  <% for (const a of appointments) { %>
    <tr>
      <td class="nowrap cell-main"><strong><%= time.formatDateTime(a.starts_at) %></strong></td>
      <td data-label="Patient"><a href="/admin/patients/<%= a.patient_id %>"><%= a.patient_name %></a><div class="small muted"><%= a.reference %></div></td>
      <td data-label="Test"><%= a.test_name %></td>
      <td data-label="Clinic · Doctor"><%= a.clinic_name %><div class="small muted"><%= a.doctor_name %></div></td>
      <td><%- include('../partials/status', { status: a.status }) %></td>
      <td class="num" data-label="Price"><%= money(a.price_pence) %></td>
      <td class="right cell-actions"><a class="btn small secondary" href="/admin/appointments/<%= a.id %>">Manage</a></td>
    </tr>
  <% } %>
  </tbody>
</table></div>
<% } %>
