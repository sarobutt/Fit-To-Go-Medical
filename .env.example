# Copy to .env for local development. On your host, set these as environment variables.

# Online Postgres database (Neon, Supabase, Render, Railway, AWS RDS...)
DATABASE_URL=postgres://user:password@host:5432/dbname
# SSL is switched on automatically for non-local hosts. Force with true/false if needed.
# DATABASE_SSL=true

# Public address of the site - used for Stripe redirect links
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Stripe (https://dashboard.stripe.com/apikeys) - use sk_test_... while testing
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook endpoint you create in Stripe (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Staff (doctors & admins) are signed out after this many minutes of inactivity
STAFF_IDLE_MINUTES=30
# Optional: only these IP addresses can reach staff pages (e.g. your clinic's internet connection)
# STAFF_ALLOWED_IPS=203.0.113.10,203.0.113.11

CURRENCY=gbp
CLINIC_TIMEZONE=Europe/London
CANCELLATION_HOURS=24

# First administrator, created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
